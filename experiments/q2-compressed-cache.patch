+                     nullptr, out, nullptr, m, k, inverse);
+}
+
+bool RoutedSlottedQ2ScaledGemm(const void* w, const __half* x,
+                               const float* inverse, const std::int32_t* tiles,
+                               std::uint32_t n_tiles, std::uint32_t tile_rows,
+                               const std::int32_t* bounds,

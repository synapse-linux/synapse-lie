+  if (r_block == 576) {
+    auto& tail = blocks[5 * capacity + physical_row];
+    reinterpret_cast<std::uint32_t*>(tail.qs)[lane] = 0;
+    if (lane < 4)
+      reinterpret_cast<std::uint32_t*>(tail.d2s6)[lane] = 0;
+  }

+bool HcCombineMoeF32(float* res, const float* expert_out, const float* weights,
+                     const float* shared_out, const float* gate,
+                     std::uint32_t gate_stride, std::uint32_t used,
+                     const float* inject, std::uint32_t inject_parts,
+                     const float* gamma, float* xn, std::uint32_t n_tokens,
+                     std::uint32_t hidden, std::uint32_t streams, float eps,
+                     hipStream_t stream) {
+  if (n_tokens < 16 || hidden != 2560 || streams != 4 || used == 0 ||
+      used > 32 || gate_stride == 0 || inject_parts == 0 || res == nullptr ||
+      expert_out == nullptr || weights == nullptr || shared_out == nullptr ||
+      gate == nullptr || inject == nullptr ||
+      (gamma != nullptr && xn == nullptr)) {
+    return false;
+  }
+  hipLaunchKernelGGL(HcCombineMoeF32Kernel, dim3(n_tokens), dim3(kThreads), 0,
+                     stream, res, expert_out, weights, shared_out, gate,
+                     gate_stride, used, inject, inject_parts, gamma, xn, hidden,
+                     eps);
+  return true;
+}

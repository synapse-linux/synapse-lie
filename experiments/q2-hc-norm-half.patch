+    }
+  }
+  __syncthreads();
+  float scale[kStreams];
+#pragma unroll
+  for (std::uint32_t k = 0; k < kStreams; ++k) {
+    float total = 0.0F;
+    for (std::uint32_t q = 0; q < kThreads / 32; ++q) {
+      total += shared[k][q];
+    }
+    scale[k] = rsqrtf(total / static_cast<float>(hidden) + eps);

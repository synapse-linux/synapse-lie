+      // Retain the measured F32 sum-of-squares contraction order.
+      const float sq = __fmaf_rn(
+          v[c].x, v[c].x,
+          __fmaf_rn(v[c].z, v[c].z,
+                    __fmaf_rn(v[c].y, v[c].y, __fmul_rn(v[c].w, v[c].w))));
+#pragma unroll

+template<int BN>
+void LaunchRoutedIQ2(const void* gate, const void* up, const __half* x,
+                     const std::int32_t* tiles, std::uint32_t n_tiles,
+                     const std::int32_t* bounds, const std::int32_t* rows_token,
+                     const std::int32_t* rows_slot, float* out, std::size_t m,
+                     std::size_t k, hipStream_t stream) {
+  const dim3 grid(static_cast<unsigned>((m + 63) / 64), n_tiles);
+  hipLaunchKernelGGL(
+      (RoutedF16GEMMKernel<WeightType::kIQ2_XXS, 128, BN, 2, true>), grid,
+      dim3(kThreads), 0, stream, gate, x, tiles, bounds, rows_token, rows_slot,
+      nullptr, out, nullptr, m, k, up);

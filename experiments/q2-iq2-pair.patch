+bool RoutedGatedIQ2Gemm(const void* gate, const void* up, const __half* x,
+                        const std::int32_t* tiles, std::uint32_t n_tiles,
+                        std::uint32_t tile_rows, const std::int32_t* bounds,
+                        const std::int32_t* rows_token,
+                        const std::int32_t* rows_slot, float* out,
+                        std::size_t m, std::size_t k, hipStream_t stream) {
+  if (!gate || !up || !x || !out || !tiles || !bounds || !rows_token ||
+      !rows_slot || !m || !k || k % 256 || !n_tiles)
+    return false;
+  switch (tile_rows) {
+    case 16:
+      LaunchRoutedIQ2<16>(gate, up, x, tiles, n_tiles, bounds, rows_token,
+                          rows_slot, out, m, k, stream);
+      break;
+    case 48:
+      LaunchRoutedIQ2<48>(gate, up, x, tiles, n_tiles, bounds, rows_token,
+                          rows_slot, out, m, k, stream);
+      break;
+    case 64:
+      LaunchRoutedIQ2<64>(gate, up, x, tiles, n_tiles, bounds, rows_token,
+                          rows_slot, out, m, k, stream);
+      break;
+    case 128:
+      LaunchRoutedIQ2<128>(gate, up, x, tiles, n_tiles, bounds, rows_token,
+                           rows_slot, out, m, k, stream);
+      break;
+    default:
+      return false;
+  }
+  return true;

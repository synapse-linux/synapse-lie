+          // Same sign bits; the 1KiB table already contains only bit7.
+          const uint2 mask =
+              reinterpret_cast<const uint2*>(kIq2HalfSignMasks)[sign];
+          signed_codes[part] =
+              make_uint2(magnitude.x ^ mask.x, magnitude.y ^ mask.y);

 class CoreBench(unittest.TestCase):
+    def test_model_owner_serial_prefill_and_native_decode_batch(self):
+        with tempfile.TemporaryDirectory(prefix='lie-core-model-flow-') as tmp:
+            root=Path(tmp);source=root/'tokens.json';source.write_text(json.dumps(list(range(8))))
+            for users in (1,2,4,8):
+                output=root/f'c{users}.jsonl';trace=root/f'c{users}.trace';graphs=root/f'graphs{users}'
+                env=dict(os.environ,LIE_BENCH_TEST_TRACE=str(trace))
+                p=subprocess.run([BINARY,'--suite','core','--model',':fixture:',
+                                  '--output',str(output),'--tokens-file',str(source),
+                                  '--context','128','--chunk','4','--users',str(users),
+                                  '--tg','8','--warmups','0','--repetitions','1',
+                                  '--kv-cache-ram-mb','0','--kv-cache-policy','legacy',
+                                  '--graphs',str(graphs)],env=env,capture_output=True,text=True,timeout=15)
+                self.assertEqual(p.returncode,0,p.stderr)
+                rows=[json.loads(line) for line in output.read_text().splitlines()]
+                self.assertEqual(rows[0]['execution'],'shared-reactive-core')
+                self.assertEqual(rows[0]['prefill_dispatch'],'single-model-owner-serial')
+                self.assertEqual(rows[0]['decode_dispatch'],'reactive-ready-native-batch')
+                jobs=[r for r in rows if r['event']=='job']
+                self.assertEqual(len(jobs),users)
+                self.assertTrue(all(r['prefill_tokens']==8 and r['prefill_calls']==2 and
+                                    r['output_tokens']==8 for r in jobs))
+                sample=next(r for r in rows if r['event']=='sample')
+                self.assertEqual((sample['model_prefill_started'],sample['model_prefill_returned']),
+                                 (users*2,users*2))
+                self.assertEqual(sample['prefill_tokens_total'],users*8)
+                self.assertEqual(sample['prefill_executor_ns_total'],sum(r['prefill_ns'] for r in jobs))
+                self.assertAlmostEqual(sample['prefill_executor_tps'],
+                                       users*8e9/sample['prefill_executor_ns_total'])
+                self.assertEqual((sample['model_decode_started'],sample['model_decode_returned']),
+                                 (8,8))
+                self.assertGreater(sample['decode_executor_ns_total'],0)
+                self.assertAlmostEqual(sample['decode_executor_tps'],
+                                       users*8e9/sample['decode_executor_ns_total'])
+                self.assertEqual(sample['decode_batches'],8 if users>1 else 0)
+                self.assertEqual(sample['decode_batch_rows'],8*users if users>1 else 0)
+                self.assertEqual(sample['decode_single_calls'],8 if users==1 else 0)
+                calls=[tuple(map(int,line.split())) for line in trace.read_text().splitlines()]
+                self.assertEqual(len(calls),users*2)
+                self.assertEqual(sum(call[1:3]==(0,4) for call in calls),users)
+                self.assertEqual(sum(call[1:3]==(4,8) for call in calls),users)
+                self.assertTrue(all(a[4]<=b[3] for a,b in zip(calls,calls[1:])))
+                self.assertEqual(len(REPORT['read_result'](output)['configurations']),1)
+                self.assertGreater((graphs/'benchmark.png').stat().st_size,0)
+                bad=copy.deepcopy(rows)
+                next(r for r in bad if r['event']=='sample')['model_prefill_started']+=1
+                corrupt=root/f'corrupt{users}.jsonl'
+                corrupt.write_text(''.join(json.dumps(r)+'\n' for r in bad))
+                with self.assertRaises(ValueError):REPORT['read_result'](corrupt)

+
+bool ConvertExpertCache(const void* encoded, void* output, bool iq2,
+                        std::uint32_t experts, std::uint32_t m, std::uint32_t k,
+                        hipStream_t stream) {
+  if (!encoded || !output || !experts || !m || !k || k % 64 || (iq2 && k % 256))
+    return false;
+  const std::size_t groups = std::size_t(experts) * m * (k / 4);
+  const dim3 grid((groups + 255) / 256);
+  if (iq2)
+    hipLaunchKernelGGL((ConvertExpertCacheKernel<true>), grid, dim3(256), 0,
+                       stream, static_cast<const std::uint8_t*>(encoded),
+                       static_cast<__half*>(output), groups, m, k);
+  else
+    hipLaunchKernelGGL((ConvertExpertCacheKernel<false>), grid, dim3(256), 0,
+                       stream, static_cast<const std::uint8_t*>(encoded),
+                       static_cast<__half*>(output), groups, m, k);
+  return hipGetLastError() == hipSuccess;
+}
+
+template<int BN, bool kPacked = false>
+void LaunchCachedIQ2(const void* gate, const void* up, const __half* x,
+                     const std::int32_t* tiles, std::uint32_t n_tiles,
+                     const std::int32_t* bounds, const std::int32_t* rows_token,
+                     const std::int32_t* rows_slot, float* out, std::size_t m,
+                     std::size_t k, hipStream_t stream) {
+  const dim3 grid(static_cast<unsigned>((m + 63) / 64), n_tiles);
+  hipLaunchKernelGGL((RoutedF16GEMMKernel<WeightType::kIQ2_XXS, 128, BN, 2,
+                                          true, kPacked, false, true>),
+                     grid, dim3(kThreads), 0, stream, gate, x, tiles, bounds,
+                     rows_token, rows_slot, nullptr, out, nullptr, m, k, up);
+}
+
+template<bool kPacked>
+bool RoutedCachedIQ2GemmImpl(const void* gate, const void* up, const __half* x,
+                             const std::int32_t* tiles, std::uint32_t n_tiles,
+                             std::uint32_t tile_rows,
+                             const std::int32_t* bounds,
+                             const std::int32_t* rows_token,
+                             const std::int32_t* rows_slot, float* out,
+                             std::size_t m, std::size_t k, hipStream_t stream) {
+  if (!gate || !up || !x || !out || !tiles || !bounds || !rows_token ||
+      !rows_slot || !m || !k || k % 256 || !n_tiles)
+    return false;
+  switch (tile_rows) {
+    case 16:
+      LaunchCachedIQ2<16, kPacked>(gate, up, x, tiles, n_tiles, bounds,
+                                   rows_token, rows_slot, out, m, k, stream);
+      break;
+    case 48:
+      LaunchCachedIQ2<48, kPacked>(gate, up, x, tiles, n_tiles, bounds,
+                                   rows_token, rows_slot, out, m, k, stream);
+      break;
+    case 64:
+      LaunchCachedIQ2<64, kPacked>(gate, up, x, tiles, n_tiles, bounds,
+                                   rows_token, rows_slot, out, m, k, stream);
+      break;
+    case 128:
+      LaunchCachedIQ2<128, kPacked>(gate, up, x, tiles, n_tiles, bounds,
+                                    rows_token, rows_slot, out, m, k, stream);
+      break;
+    default:
+      return false;
+  }
+  return true;
+}
+
+bool RoutedCachedIQ2Gemm(const void* gate, const void* up, const __half* x,
+                         const std::int32_t* tiles, std::uint32_t n_tiles,
+                         std::uint32_t tile_rows, const std::int32_t* bounds,
+                         const std::int32_t* rows_token,
+                         const std::int32_t* rows_slot, float* out,
+                         std::size_t m, std::size_t k, hipStream_t stream) {
+  return RoutedCachedIQ2GemmImpl<false>(gate, up, x, tiles, n_tiles, tile_rows,
+                                        bounds, rows_token, rows_slot, out, m,
+                                        k, stream);
+}

+extern "C" int qfn_mmq_q8_0_to_q5_0_overlay(
+    const void* source, void* destination, size_t blocks,
+    hipStream_t stream) {
+  if (!source || !destination || blocks == 0) return -1;
+  requant_q8_0_to_q5_0<<<unsigned((blocks + 127) / 128), 128, 0, stream>>>(
+      static_cast<const block_q8_0*>(source),
+      static_cast<block_q5_0*>(destination), blocks);
+  return hipGetLastError() == hipSuccess ? 0 : -2;
+}
+
+extern "C" int qfn_mmq_q5_0_dense_vec_preq(
+    const void* weights, const void* gate, const void* input,
+    float* output, int rows, int n_tokens, int cols,
+    hipStream_t stream) {
+  if (!weights || !input || !output || rows <= 0 || n_tokens != 1 ||
+      cols <= 0 || cols % QK5_0 != 0) return -1;
+  if (gate) {
+    mul_mat_vec_q5_dense<true><<<rows, 32, 0, stream>>>(
+        weights, gate, static_cast<const block_q8_1*>(input), output,
+        unsigned(cols), unsigned(rows));
+  } else {
+    mul_mat_vec_q5_dense<false><<<rows, 32, 0, stream>>>(
+        weights, nullptr, static_cast<const block_q8_1*>(input), output,
+        unsigned(cols), unsigned(rows));
+  }
+  return hipGetLastError() == hipSuccess ? 0 : -2;

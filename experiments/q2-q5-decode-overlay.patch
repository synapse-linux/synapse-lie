@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+// Private one-token Q5_0 decoder and in-memory Q8_0 overlay experiment.
+template<bool has_gate>
+__launch_bounds__(32, 1) static __global__ void mul_mat_vec_q5_dense(
+    const void* __restrict__ weights, const void* __restrict__ gate,
+    const block_q8_1* __restrict__ input, float* __restrict__ output,
+    const uint32_t ncols_x, const uint32_t nrows_x) {
+  constexpr int qi = QI5_0;
+  constexpr int vdr = VDR_Q5_0_Q8_1_MMVQ;
+  constexpr int blocks_per_iter = vdr * 32 / qi;
+  const int lane = threadIdx.x;
+  const int row = blockIdx.x;
+  const int blocks_per_row = ncols_x / QK5_0;
+  const int row_offset = row * blocks_per_row;
+  const int kqs = vdr * (lane % (qi / vdr));
+  float sum = 0.f;
+  float gate_sum = 0.f;
+  for (int kbx = lane / (qi / vdr); kbx < blocks_per_row;
+       kbx += blocks_per_iter) {
+    sum += vec_dot_q5_0_q8_1(weights, input + kbx, row_offset + kbx, kqs);
+    if constexpr (has_gate) {
+      gate_sum += vec_dot_q5_0_q8_1(gate, input + kbx,
+                                    row_offset + kbx, kqs);
+    }
+  }
+  sum = warp_reduce_sum<32>(sum);
+  if constexpr (has_gate) gate_sum = warp_reduce_sum<32>(gate_sum);
+  if (lane == 0) {
+    float value = sum;
+    if constexpr (has_gate) value *= ggml_hip_op_silu_single(gate_sum);
+    output[row] = value;
+  }
+}
+
+// One conversion per GGML block. Startup-only; the original Q8_0 allocation
+// remains resident for the unchanged batched prefill path.
+__global__ static void requant_q8_0_to_q5_0(
+    const block_q8_0* __restrict__ source,
+    block_q5_0* __restrict__ destination, size_t blocks) {
+  const size_t index = size_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (index >= blocks) return;
+  const block_q8_0& in = source[index];
+  block_q5_0 out{};
+  const float d8 = __half2float(in.d);
+  int peak_code = 0;
+  for (int j = 0; j < QK8_0; ++j)
+    peak_code = max(peak_code, abs(int(in.qs[j])));
+  const float desired_scale = fabsf(d8) * float(peak_code) / 15.0f;
+  out.d = __float2half_rn(desired_scale);
+  const float d5 = __half2float(out.d);
+  uint32_t high = 0;
+  for (int j = 0; j < QK5_0; ++j) {
+    const float weight = d8 * float(in.qs[j]);
+    int code = d5 > 0.0f ? __float2int_rn(weight / d5) : 0;
+    code = max(-16, min(15, code));
+    const unsigned packed = unsigned(code + 16);
+    high |= ((packed >> 4) & 1u) << j;
+    out.qs[j & 15] |= uint8_t((packed & 15u) << (j < 16 ? 0 : 4));
+  }
+  for (int j = 0; j < 4; ++j) out.qh[j] = uint8_t(high >> (8 * j));
+  destination[index] = out;
+}
